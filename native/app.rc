#include <windows.h>
1 RT_MANIFEST "app.manifest"

201 DIALOGEX 0, 0, 460, 310
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Driver license"
FONT 9, "Microsoft YaHei UI"
BEGIN
    EDITTEXT 202, 8, 8, 444, 268, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER
    DEFPUSHBUTTON "Accept and download", IDOK, 215, 286, 132, 16
    PUSHBUTTON "Cancel", IDCANCEL, 355, 286, 95, 16
END

1 VERSIONINFO
FILEVERSION 0,1,5,0
PRODUCTVERSION 0,1,5,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Driver Source native C downloader\0"
            VALUE "FileVersion", "0.1.5\0"
            VALUE "ProductName", "Driver Source\0"
            VALUE "ProductVersion", "0.1.5\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
